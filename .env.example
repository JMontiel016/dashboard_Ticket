# Habilita acciones directas individuales en este dashboard.
# En producción debe usarse en una instalación con acceso restringido a operadores.
# Vite: copiar a .env. Cloudflare: configurar en variables del servidor.
MONITOR_ACTIONS_ENABLED=true

# Detalle y vistas previas de imágenes: credenciales del servidor Jira.
# No usar prefijo VITE ni guardar tokens en archivos entregados al navegador.
# JIRA_EMAIL=correo-del-usuario-de-api
# JIRA_TOKEN=token-de-api

# npm run dev solicita estas credenciales en la terminal una sola vez.
# Comprueba una imagen de este ticket antes de abrir la aplicación.
# JIRA_VERIFY_KEY=CW-236
